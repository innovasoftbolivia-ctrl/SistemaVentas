# Plantilla de configuración del Sistema de Ventas cuando corre DENTRO de Docker.
#
# docker-compose.yml lo pasa como `env_file` a los servicios app y vite, así que
# estas variables llegan al contenedor como variables de entorno reales. Laravel
# carga Dotenv en modo inmutable, de modo que mandan sobre lo que diga el .env
# del bind mount —que sigue siendo el bueno para trabajar sin Docker, con la
# base en 127.0.0.1:13310.
#
# La diferencia esencial son dos líneas: DB_HOST=mysql y DB_PORT=3306, porque
# dentro de la red de compose se llega al contenedor por su nombre y por el
# puerto interno, no por el publicado en el host.
#
# CÓMO USAR ESTA PLANTILLA (una sola vez, por instalación):
#
#   cp .env.docker.example .env.docker
#
# y completa APP_KEY y DB_PASSWORD antes de `docker compose up`:
#
#   APP_KEY:      php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
#   DB_PASSWORD:  cualquier contraseña propia — distinta en cada instalación
#                 real, para que filtrar una no comprometa a las demás. Debe
#                 coincidir con DB_PASSWORD en el .env de la raíz del repo
#                 (ver .env.example junto a docker-compose.yml).
#
# `.env.docker` NO se sube al repositorio (está en .gitignore): cada instalación
# —de desarrollo o de un cliente— tiene su propia clave y su propia contraseña.

APP_NAME="Sistema de Ventas"
APP_ENV=local
APP_KEY=
# En una instalación real (cliente) deja esto en false: con true, un error
# muestra el stack trace completo —rutas del servidor, consultas SQL— a quien
# sea que esté mirando la pantalla en ese momento.
APP_DEBUG=false
APP_URL=http://localhost:8100
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Lima

VITE_APP_NAME="${APP_NAME}"

# "daily" y no "single": un solo storage/logs/laravel.log crece sin límite.
# Con "daily", Laravel rota un archivo por día y borra los de más de 14 (la
# opción LOG_DAILY_DAYS, con ese valor por omisión) — sin esto, en un
# servidor real el disco se llena solo, tarde o temprano.
LOG_CHANNEL=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ventas_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# En true si el servidor queda detrás de HTTPS (ver README, "Nueva instalación"):
# el navegador deja de mandar la cookie de sesión por HTTP plano, así que un
# atacante en la misma red no puede robarla espiando el tráfico. En false
# mientras el sitio solo se sirva por HTTP, o el login deja de funcionar.
SESSION_SECURE_COOKIE=false

# Vacío mientras nginx reciba las visitas directo (como en desarrollo). Si el
# servidor real queda detrás de un proxy (el mismo del paso de HTTPS): la IP
# del proxy, separada por comas si son varias, o "*" si es de confianza total
# (un balanceador en la misma red privada, por ejemplo). Sin esto detrás de un
# proxy, la bitácora registra la IP del proxy en vez de la del cliente.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
