APP_NAME="Sistema de Ventas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Lima

VITE_APP_NAME="${APP_NAME}"

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Base de datos ventas_db (docker compose en la raíz del repo)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=ventas_db
DB_USERNAME=root
DB_PASSWORD=ventas123

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
