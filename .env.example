# Variables que usa docker-compose.yml del Sistema de Ventas (no las de Laravel:
# esas van en sistema-ventas/.env.docker).
#
# Copia este archivo a `.env` en esta misma carpeta y pon una contraseña propia.
# Sin este archivo, docker-compose usa "ventas123" como respaldo (ver el `:-`
# en docker-compose.yml) para no romper una instalación de desarrollo que ya
# existía sin este archivo — pero una instalación real (cliente) SÍ debería
# tener el suyo, distinto, para que filtrar una contraseña no comprometa a las
# demás instalaciones.
#
# Debe coincidir con DB_PASSWORD en sistema-ventas/.env.docker.
DB_PASSWORD=ventas123
